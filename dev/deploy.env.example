# Production server for .claude/skills/screenings-dev/scripts/deploy.sh.
# Copy to dev/deploy.env (git-ignored) and fill in. Never commit the real file.

# SSH login and private key.
DEPLOY_SSH="user@nextcloud.example.com"
DEPLOY_KEY="$HOME/.ssh/id_ed25519"
# Nextcloud's folder, relative to the SSH user's home (or absolute).
DEPLOY_NC_DIR="nextcloud"
# The app folder inside it: "apps" or a writable entry of apps_paths, e.g. "custom_apps".
DEPLOY_APPS_DIR="apps"
# PHP that runs occ, with options if needed (e.g. "/usr/bin/php8.4 -d memory_limit=512M").
DEPLOY_PHP="php"
# Public URL, for the final check.
DEPLOY_URL="https://nextcloud.example.com"
